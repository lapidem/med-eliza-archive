# =============================================
# med-ELIZA Configuration File (pd.conf)
# rev. 1.91
# =============================================

# ------------------- 基本設定 -------------------
# デバッグモード（on にすると詳細が出力されます）
DEBUG="off"

# 著作権表示（HTMLフッターに表示）
COPYRIGHT="(c) lapidem 2025"

# ------------------- 検索設定 -------------------
# 最大検索件数（マシンの性能に合わせて調整）
SCALE=500

# 稀少語と判断する閾値（この頻度以下の単語はInLine/Multiに回されます）
THRESH=10

# 履歴保持数（restoreボタンで表示される履歴の最大数）
hLIMIT="32"

# ------------------- パス設定 -------------------
# PubMedテキストファイルの場所（重要！）
XMLDIR="pubmedxml/"

# 一時ファイルのベースディレクトリ（/tmp 以下が推奨）
# TMPDIR="/tmp/pd"

# ------------------- 外部ツール設定 -------------------
# WordNet がインストールされている場合のパス
# WN=$(which wn)

# TreeTagger (tte) がインストールされている場合
# TTE=$(which tte)

# gene辞書のパス（見つからなければ XMLDIR/gene-utf8.txt を使用）
# GENEDIC="${XMLDIR}gene-utf8.txt"

# ------------------- 表示・UI設定 -------------------
# 1ページあたりの表示行数（KWIC/InLine/Multi）
LINES=100

# KWIC表示時の横幅（文字数）
WIDTH=100

# ------------------- その他 -------------------
# デフォルトの検索モード（strict / loose）
# SRCH="strict"

# ページ遷移時のジャンプ幅（fast << >> 用）
# LEAP=500
