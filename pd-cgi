crossTable(){ ## $1: column number
    #            col
    #       0  1  2  3   4
    #-----+-----------------
    # r 0 | 1  4  7  10  13
    # o 1 | 2  5  8  11  14
    # w 2 | 3  6  9  12
    #
    # COLUMN=5, ROW= int( ln /COLUMN ) + 1/0
    # ind = row + 1 + ROW * col
    awk -v COLUMN=$1 '
    BEGIN { ln= 1 }
    {
	line[ln] = $0
	ln++
    }
    END {
	ln--;
	ROW=int(ln / COLUMN);
	if(ln % COLUMN ) ROW++;
	print "<TABLE>"
	for(row=0; row<ROW; row++){
	    print "<TR>"
	    for (col=0; col<COLUMN; col++){
		ind= row + 1 + ROW * col
		print "<TD>", line[ind], "</TD>"
	    }
	    print "</TR>"
	}
	print "</TABLE>"
    }
    '
    
}
