REVISION="0.3"
HISTORY="/tmp/pdhistory"
ESCK=$'\x1b\x5b\x4b' #del to the end
ESC_=$'\x1b\x5b'
_D=$'\x44' #move left

bol(){ ### readhistory
    nback=${#_RES};
    if [ $nback != "0" ]; then 
	echo -ne $ESC_$nback$_D$ESCK
	REStmp=$_RES; _RES=""
    fi
}
gethist(){ ### readhistory
    _RES=`cat $HISTORY | awk -v lnum=$1 'NR==lnum'`
}
arrowup(){ ### ring buffer
    bol; gethist $ind; echo -ne $_RES; 
    if [ $ind -gt 1 ]; then let ind--; else ind=$count; fi
}
arrowdown(){
    bol; gethist $ind; echo -ne $_RES; let ind++;
    if [ $ind -gt $count ]; then ind=1; fi
}
readhistory(){
    ## read history
    if [ -e $HISTORY ]; then count=`cat $HISTORY |wc -l`; else count=0; fi
    ind=$count; _RES=""
    ## trap upper and lower arrow key
    tIFS=$IFS; IFS=
    while  read -sr -n1 chr; do
	if [ ! $chr ]; then break; fi
	if [  $'\x1b' = $chr ]; then ## escape key is down
	    read -s -n1 chr2; read -s -n1 chr3;
	    case $chr3 in
		$'\x41') arrowup;;
		$'\x42') arrowdown;;
		else) echo "trapped";;
	    esac
	elif [ $'\cp' = $chr ]; then arrowup
	elif [ $'\cn' = $chr ]; then arrowdown
	elif [ $'\x7F' = $chr ] || [ $'\ch' = $chr ]; then ## DEL
	    loc=${#_RES}; 
	    if [ $loc -gt 1 ]; then
		loc=$(( loc - 1 ))
		_RES=`echo $_RES|cut -c 1-$loc`;
		echo -ne "\b"$ESCK; 
	    else
		if [ $loc = 1 ]; then echo -ne "\b"$ESCK; fi
		loc="0"; _RES=""
	    fi
	elif [ $'\ce' = $chr ]; then
	    bol; echo -ne $REStmp; _RES=$REStmp; 
	elif [ $'\ca' = $chr ]; then  bol; #begin of line
	elif [[ $chr =~ [$'\x20'-$'\x7e'] ]]; then
	    echo -ne $chr
	    _RES=$_RES$chr
	fi
    done
    IFS=$tIF
    return
}

