#### make dictionary from pubf.txt
###     which is made of pubmed -U
makedic(){
    awk '
    BEGIN{
	cwords="*, #, %, DOI:, However, then after two RESULTS: than = can our did had three within could well one only most all more agaist However they between  during into - been from their other such were may these be have of the in and a to is that as with by or was for which on  we has an when also are both but not its this using via"

    }
    {
	split($0, wrd)
	limit=length(wrd)
	for(i=1;i<=limit;i++){
	    if( ! index(tolower(cwords), tolower(wrd[i]))){
		word[ wrd[i] ]++
		if( i < length -1 ){
		    phrs = wrd[i] " " wrd[i+1]; word[ phrs ]++
#		    phrs = phrs " " wrd[i+2]; word[ phrs ]++
#		    phrs = wrd[i+1] " " wrd[i+2]; word[ phrs ]++
		}
	    }
	}
    }

    
    END {
	cmd="sort -n"
	for( w in word ){
	    printf("%d %s\n", word[w], w) 
	}
	close(cmd)
    }'
}


