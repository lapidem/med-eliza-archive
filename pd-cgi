	echo -ne "$FREQ occurrences (No.$ENHI${ORDER}$ENHe in the rank) during 5 years in the PubMed."
	if [ ! -e "$KWICLINE" ]; then
	    echo " [no cache]"
	    _grepline="${PRDIR}/grepline"
	    debug "oKEY:$oKEY, KEY:$KEY"
