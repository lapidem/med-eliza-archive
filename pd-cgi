	    ### remove TAGs the most short regular expression
	    cat $INPF |grepline "$KEY" | sed -e 's/<[^>]*>//g' > $_grepline
	    cat $_grepline | _kwic "$KEY" > $KWICLINE
	found=`wc -l $KWICLINE|awk '{print $1}'`
	echo -en " $found found\r"
	debug "R,L-PAGE, R,L-KWIC: $RPAGE,$LPAGE,$RKWIC,$LKWIC"
