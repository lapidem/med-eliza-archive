	elif [ ! -e $linkTmp ]; then
	    INPF=${PUBF}*.txt
	    cat $INPF | grepline "$KEY" |rdictionary |
	    	sort -nr > $linkTmp
	    BJOB=$!
	fi
	debug "uHist: $KEYNAME"
	updateHistory "$KEYNAME"
	found=`wc -l $linkTmp|awk '{print $1}'`
	echo -e " $found found"
    	display $START $LINES $linkTmp 3 on
	hint
	wordnet $KEY
    else
	elizaClaim;
	PAGE="eliza"
    fi
