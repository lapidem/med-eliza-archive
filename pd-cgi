mfilter(){
    awk '
    BEGIN{rec=1; ndata="id"}
    /^#/ && ndata == "id" {
	PMID="<a href=https://www.ncbi.nlm.nih.gov/pubmed/?term=" $2
	PMID = "PMID: "  PMID " target=_blank>" $2 "</a>"
	id= rec ") " PMID;
#	id= PMID;
	rec++
	ndata = "journal"
    }
    /^%/ && ndata == "journal" {
	split($0, doi, "DOI: ");
	doilink="<a href=https://doi.org/" doi[2] " target=_blank>" doi[2] "</a>"
#	printf("DOI:%s\n%s\n", doilink, doi[1])
	journal=doi[1];
	ndata = "title"
    }
    /^\*/ && ndata == "title" {
	title = "<strong>" $0 "<\/strong>"
	ndata = "abstract"
    }
    /^-/ && ndata == "abstract" {
	print id, "DOI: " doilink
	print journal
	print title
	print; ndata = "id"
	print "<br>"
    }
'
} #mfilter
