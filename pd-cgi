	cat $KWICLINE |
	    sort -k3nr,3nr -k5,5 -k7 -k4nr,4nr |kwic-core l "$KEY" > $LPAGE
	cat $KWICLINE |
	    sort -k3nr,3nr -k5,5 -k7 -k4nr,4nr |kwic-core s "$KEY" > $LKWIC
	cat $KWICLINE |awk '{print $3,$5}' |sort -k1nr,1nr -k2 |uniq >$LDIC
	cat $KWICLINE |awk '{print $4,$6}' |sort -k1nr,1nr -k2 |uniq >$RDIC
	else echo " [cache]"
	fi
	debug "<br>oKEY:$oKEY, KEY:$KEY"
