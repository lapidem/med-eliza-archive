### kwic old routine
### kwic makes /tmp/kwic
###     which contains information enough to make kwic output
###     by kwic-core
kwic(){ ### parameter is a keyword
    awk -v key="$1" -v key2="$2" '
    BEGIN{ num =1 }
    $0 !~ /^\*/ && $0 !~ /^%/ { ### skip source info and title
	sub(/^- /,"") ### remove the tag of abstract
	split($0, line, /\../)
	for(i=1; i<=length(line); i++){ ### for each line i
	    loc = index(tolower(line[i]), tolower(key))
	    if(loc) {
		split(line[i], word)
		for(j=1; j<=length(word); j++){ ### for each word j
		    if( pos=index(tolower(word[j]),tolower(key))){
			### multiple key; next word must be key2
			### rev 1.36 thne next word must contain key2
#			if(key2 && word[j+1] != key2) break ###rev1.9
			if(key2) {
			    pos2=index(tolower(word[j+1]), tolower(key2))
			    if ( ! pos2 ) {break}
			}
			ind[num]=loc; position[num]=j;
			if (j>1) {
			    lword[num]= word[j-1]; lfreq[ lword[num] ]++ }
			else {
#			    lword[num]= "<null>"; lfreq["<null>"]++ }
			    lword[num]= "*null*"; lfreq["*null*"]++ }
			if (j<length(word)){
			    if(key2 && (j+2)<=length(word)){  ### rev1.9
				rword[num]=word[j+2]; rfreq[ rword[num] ]++
			    }else{
				rword[num]=word[j+1]; rfreq[ rword[num] ]++
			    }
			}else {
#			    rword[num]="<null>"; rfreq["<null>"]++ }
			    rword[num]="*null*"; rfreq["*null*"]++ }
			lstr[num]=substr(line[i], 1, loc -1)
			rstr[num]=substr(line[i], loc, length(line[i])-loc+1 )
			break
		    }
		}
		num++
	    }
	}
    }
    END{
#	for(i=1; i<=num; i++){  
	for(i=1; i<num; i++){  ## rev 1.20
	    printf("%d %d %d %d %s %s %s_:_%s%s\n", ind[i], position[i],
		   lfreq[lword[i]], rfreq[rword[i]], lword[i], rword[i],
		   rstr[i],lstr[i], rstr[i] )
	}
    }'  
} ### kwic: now obsolete use splitline | _kwic

### kwic makes /tmp/kwic
### treat input as a line
###     which contains information enough to make kwic output
###     by kwic-core
_kwic(){ ### parameter is a keyword
#    awk -v key="$1" -v key2="$2" '
    awk -v key="$1" -v SRCH="$SRCH" '
    BEGIN {
	split(key, keywords); nKey=length(keywords);
	num=1
    }
    function setvalue(ind){
	if(ind > 1 ){
	    lword = words[ind - 1 ]; lfreq[lword]++ }
	else {
	    lword= "*null*"; lfreq["*null*"]++ }
	if( ind < length(words) - nKey + 1 ) {
	    rword=words[ind + nKey]; rfreq[ rword ]++}
	else {
	    rword="*null*"; rfreq["*null*"]++ }
	position = ind;  ### words[i] is the target key
	loc = 0;
	for(pos=1; pos<position; pos++){
	    loc = loc + length(words[pos]) + 1
	}
	found = 1; loc++;
	lstr=substr(line, 1, loc -1)
	rstr=substr(line, loc, length(line)-loc+1 )
    }
    {
	line=$0; gsub(/\.$/,""); ### avoid . in the last word
	split($0, words);
#	print key line; ##debug
	found = 0;
	for(i=1; i<=length(words)-nKey+1; i++){
	    target = words[i];
	    for(ind=1; ind<nKey; ind++){
		target = target " " words[i + ind];
	    }
	    if(toupper(target) == toupper(key)){
		found = 1; setvalue(i); break;
	    }
	}
	if( SRCH != 'strict' && ! found ){
	    ind = index(toupper(line), toupper(key));
	    if(ind){
		location=0; found=1;
		for(i=1; i<=length(words)-nKey+1; i++){
		    location=location+length(words[i]) + 1;
		    if(location >= ind){
			setvalue(i); loc=ind; break;
		    }
		}
	    }
	}
	if( found ) {
	    aLoc[num]=loc; aPosition[num]=position;
	    aLword[num]=lword; aRword[num]=rword;
	    aRstr[num]=rstr; aLstr[num]=lstr;
	    num++;
	} 
	### if not found the keyword is embeded in the word; e.g. T-cells
	### in this version discarded 1.82
    }
    END{
	for(i=1; i<num; i++){
#	printf("%d %d %d %d %s %s %s_:_%s%s\n", ind, position,
	    printf("%d %d %d %d %s %s %s_:_%s%s\n", aLoc[i], aPosition[i],
	       lfreq[aLword[i]], rfreq[aRword[i]], aLword[i], aRword[i],
	       aRstr[i], aLstr[i], aRstr[i])
	}
    }'  
} ### _Kwic

### format of kwic: output of kwic
### ind(char) position(string) lfreq rfreq lword rword rstring
#    _:_sentence
## lr=l/r/s: left, right, simple
kwic-core(){ 
#   remove space between $2 and $3 when $3 is empty
    kSTR=`echo "$2 $3" | sed 's/[ ]$//'`
    awk -v lr=$1 -v key="$kSTR" -v HLINE=$HLINE 'BEGIN{
	ENHI="<strong>" #intense
	ENHe="</strong>"
	FS="_:_"
	count=1
	_Key = toupper(substr(key, 1,1)) substr(key,2,length(key)-1)
    }
